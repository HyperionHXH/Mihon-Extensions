      "id": "picacomic",
      "name": "哔咔漫画（需原生网关宿主）",
      "type": "manga",
      "lang": "zh",
      "version": "1.0.4",
      "url": "https://raw.githubusercontent.com/HyperionHXH/Mihon-Extensions/main/repo/triomi/rules/picacomic.json",
